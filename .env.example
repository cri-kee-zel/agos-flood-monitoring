# .env.example - copy to .env and fill values (DO NOT commit .env)
# See README or Render docs for setting these as environment variables

# Server runtime
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Auth
JWT_SECRET=

# Email (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AGOS <no-reply@example.com>"

# SMS Gateway (Android gateway / proxy)
SMS_GATEWAY_URL=https://api.sms-gate.app:443
SMS_GATEWAY_USER=PGTRN
SMS_GATEWAY_PASS=glootxy0ncshl1
SMS_GATEWAY_DEVICE_ID=a3VFk4Ff-DaBFvIKJ1BnA

# External APIs
SENTINEL_INSTANCE_ID=
SENTINEL_CLIENT_ID=
AI4G_ENDPOINT=
AI4G_KEY=

# Database (optional)
# Use a managed DB in production; leave empty to use local sqlite
DATABASE_URL=
SQLITE_PATH=./data/agos.sqlite

# Monitoring / logging
SENTRY_DSN=
LOG_LEVEL=info
# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (if using database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agos_monitoring
DB_USER=agos_user
DB_PASSWORD=your_secure_password_here

# Security Keys (Generate new ones for production!)
JWT_SECRET=your_super_secure_jwt_secret_key_here_change_this
ENCRYPTION_KEY=your_32_character_encryption_key

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS/GSM Configuration
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# Arduino/Hardware Configuration
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD_RATE=9600
SENSOR_UPDATE_INTERVAL=5000

# External API Keys
WEATHER_API_KEY=your_weather_api_key
MAPS_API_KEY=your_google_maps_api_key

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_if_using

# CORS Origins (comma separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
